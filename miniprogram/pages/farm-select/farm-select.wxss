.container {
  min-height: 100vh;
  background: transparent;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.header {
  padding: 18rpx 0 10rpx;
  margin-bottom: 12rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1c1e;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #5f6464;
  display: block;
}

/* 搜索框 */
.search-box {
  margin-bottom: 16rpx;
  padding: 18rpx 18rpx;
}

.search-wrapper {
  display: flex;
  align-items: center;
  background: #f1f2f3;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #5f6464;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1c1c1e;
  height: 72rpx;
  line-height: 72rpx;
}

.clear-icon {
  font-size: 40rpx;
  color: #5f6464;
  line-height: 1;
  padding: 0 8rpx;
  margin-left: 8rpx;
}

.farm-list {
  background: transparent;
}

.farm-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 16rpx;
}

.farm-item:active {
  opacity: 0.92;
  transform: scale(0.99);
}

.farm-item.active {
  border-color: rgba(0, 135, 205, 0.55);
}

.farm-info {
  flex: 1;
}

.farm-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 10rpx;
}

.farm-codes {
  display: flex;
  gap: 20rpx;
}

.farm-code {
  font-size: 24rpx;
  color: #5f6464;
}

.farm-dhi {
  font-size: 24rpx;
  color: #0087cd;
}

.farm-dhi-empty {
  font-size: 24rpx;
  color: #ff9500;
}

.farm-action {
  margin-left: 20rpx;
}

.check-icon {
  font-size: 40rpx;
  color: #0087cd;
  font-weight: bold;
}

.arrow-icon {
  font-size: 32rpx;
  color: #ccc;
}

.empty {
  text-align: center;
  padding: 100rpx 30rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #5f6464;
  margin-bottom: 20rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #979797;
}

.tips {
  padding: 30rpx;
}

.tips-text {
  display: block;
  font-size: 24rpx;
  color: #5f6464;
  line-height: 2;
}

/* DHI编号弹窗 */
.dhi-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.dhi-content {
  width: 85%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.dhi-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #e0edf6;
}

.dhi-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.dhi-close {
  font-size: 48rpx;
  color: #5f6464;
  line-height: 1;
}

.dhi-body {
  padding: 40rpx 30rpx;
}

.dhi-farm-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0087cd;
  margin-bottom: 8rpx;
}

.dhi-farm-code {
  display: block;
  font-size: 24rpx;
  color: #5f6464;
  margin-bottom: 20rpx;
}

.dhi-hint {
  display: block;
  font-size: 26rpx;
  color: #1c1c1e;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.dhi-note {
  display: block;
  font-size: 22rpx;
  color: #5f6464;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.dhi-input {
  width: 100%;
  padding: 24rpx 20rpx;
  border: 2rpx solid #d8d8d8;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f6fbfd;
  color: #1c1c1e;
  line-height: 1.4;
  height: auto;
  min-height: 80rpx;
}

.dhi-input::placeholder {
  color: #979797;
  font-size: 26rpx;
}

.dhi-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.dhi-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  border: none;
  border-radius: 0;
  background: #fff;
  padding: 0;
  margin: 0;
}

.dhi-btn::after {
  border: none;
}

.dhi-btn-cancel {
  color: #5f6464;
  border-right: 1rpx solid #eee;
}

.dhi-btn-confirm {
  color: #0087cd;
  font-weight: 600;
}

/* 管理员操作 */
.admin-actions {
  padding: 12rpx 0 0;
}

.admin-btn {
  width: 100%;
  height: 88rpx;
  background: #0087cd;
  color: #fff;
  border: none;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
}

.admin-btn::after {
  border: none;
}
