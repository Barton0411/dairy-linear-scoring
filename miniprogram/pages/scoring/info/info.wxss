/* pages/scoring/info/info.wxss */

.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.card {
  flex: 1;
}

.form-group {
  margin-bottom: 40rpx;
}

.farm-info, .hint-info {
  padding: 24rpx;
  background: #f2f8fb;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.farm-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.hint-text {
  font-size: 26rpx;
  color: #5f6464;
  text-align: center;
  line-height: 1.6;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d8d8d8;
  border-radius: 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  background: #fff;
}

.action-area {
  padding-top: 40rpx;
}

.btn-primary {
  height: 96rpx;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  background: #0087cd;
  color: #fff;
  border-radius: 24rpx;
  box-shadow: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-primary:active {
  opacity: 0.88;
}

.form-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5f6464;
  line-height: 1.6;
}
