/* pages/scoring/info/info.wxss */

.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.card {
  flex: 1;
}

.form-group {
  margin-bottom: 40rpx;
}

.farm-info, .mode-info {
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.farm-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.mode-name {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.mode-name.normal {
  background: #e8f5e9;
  color: #07C160;
}

.mode-name.defect {
  background: #fff3e0;
  color: #ff9500;
}

.mode-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.input-wrapper {
  display: flex;
  align-items: center;
}

.form-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx 0 0 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.scan-btn {
  width: 88rpx;
  height: 88rpx;
  background: #07C160;
  border-radius: 0 12rpx 12rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.scan-icon {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.action-area {
  padding-top: 40rpx;
}

.btn-primary {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
}

.btn-primary[disabled] {
  opacity: 0.5;
}
