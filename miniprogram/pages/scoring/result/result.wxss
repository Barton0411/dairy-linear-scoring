/* pages/scoring/result/result.wxss */

.container {
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

/* 结果卡片 */
.result-card {
  background: #0087cd;
  border-radius: 24rpx;
  padding: 40rpx;
  color: #fff;
  margin-bottom: 30rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.cattle-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ear-tag {
  font-size: 32rpx;
  font-weight: 600;
}

.parity {
  font-size: 26rpx;
  opacity: 0.9;
}

.mode-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
}

.score-display {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.total-score, .grade-display {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-number {
  font-size: 96rpx;
  font-weight: bold;
  line-height: 1;
}

.grade-text {
  font-size: 72rpx;
  font-weight: bold;
  line-height: 1;
}

.score-label, .grade-label {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 12rpx;
}

.extra-scores {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.extra-item {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 操作卡片 */
.action-card {
  margin-top: 10rpx;
}

.action-title {
  font-size: 26rpx;
  color: #5f6464;
  display: block;
  margin-bottom: 18rpx;
}

/* 详情区域 */
.detail-section {
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  display: block;
  margin-bottom: 20rpx;
}

.category-card {
  /* use global .card */
  margin-bottom: 16rpx;
}

.category-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e0edf6;
}

.category-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.category-weight {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}

.trait-scores {
  display: flex;
  flex-wrap: wrap;
}

.trait-score {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.trait-score:nth-child(odd) {
  padding-right: 20rpx;
}

.trait-score:nth-child(even) {
  padding-left: 20rpx;
}

.trait-name {
  font-size: 26rpx;
  color: #5f6464;
}

.trait-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #0087cd;
}

/* 照片区域 */
.photo-section {
  margin-bottom: 30rpx;
}

.photo-scroll {
  white-space: nowrap;
}

.photo-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  display: inline-block;
}

/* 操作区域 */
.secondary-actions {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: 18rpx 0 8rpx;
}

.link-btn {
  font-size: 28rpx;
  color: #0087cd;
  padding: 10rpx 20rpx;
}

.link-btn:active {
  opacity: 0.7;
}

.success-message {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.success-icon {
  width: 100rpx;
  height: 100rpx;
  background: #0087cd;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.success-text {
  font-size: 32rpx;
  color: #1c1c1e;
}

.btn-secondary {
  background: #eef0f2;
  color: #5f6464;
}

.btn-primary {
  background: #0087cd;
  color: #fff;
  border-radius: 24rpx;
  box-shadow: none;
}

/* 展开/收起 */
.details-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid #e0edf6;
  color: #1c1c1e;
  font-size: 28rpx;
}

.details-toggle:active {
  opacity: 0.92;
}

.details-arrow {
  color: #5f6464;
  font-size: 24rpx;
}
