<!--pages/scoring/normal/normal.wxml-->
<view class="container">
  <!-- 顶部信息 -->
  <view class="header">
    <view class="cattle-info">
      <text class="ear-tag">牛号: {{currentScoring.earTag}}</text>
      <text class="mode-tag">正常模式</text>
    </view>
    <view class="score-preview">
      <text class="score-value">{{totalScore.score}}</text>
      <text class="score-grade" style="color: {{totalScore.grade === 'Ex' ? '#FFD700' : totalScore.grade === 'VG' ? '#FF6B6B' : '#07C160'}}">{{totalScore.grade}}</text>
    </view>
  </view>

  <!-- 分类选项卡 -->
  <scroll-view class="category-tabs" scroll-x enable-flex>
    <view
      class="tab-item {{currentCategoryIndex === index ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="key"
      data-index="{{index}}"
      bindtap="onCategoryChange"
    >
      <text>{{item.name}}</text>
      <text class="tab-weight">({{item.weight * 100}}%)</text>
    </view>
  </scroll-view>

  <!-- 评分内容 -->
  <swiper
    class="scoring-swiper"
    current="{{currentCategoryIndex}}"
    bindchange="onCategoryChange"
    duration="300"
  >
    <swiper-item wx:for="{{categories}}" wx:key="key" wx:for-item="category">
      <scroll-view class="trait-list" scroll-y>
        <view class="trait-item" wx:for="{{category.traits}}" wx:key="key" wx:for-item="trait">
          <view class="trait-header">
            <text class="trait-name">{{trait.name}}</text>
            <text class="trait-value">{{currentScoring.scores[trait.key]}}</text>
          </view>

          <view class="trait-labels">
            <text class="label-low">{{trait.low}}</text>
            <text class="label-high">{{trait.high}}</text>
          </view>

          <slider
            class="score-slider"
            min="1"
            max="9"
            step="1"
            value="{{currentScoring.scores[trait.key]}}"
            activeColor="#07C160"
            block-size="24"
            data-key="{{trait.key}}"
            bindchange="onSliderChange"
          />

          <!-- 快捷分数按钮 -->
          <view class="quick-scores">
            <view
              class="quick-btn {{currentScoring.scores[trait.key] === item ? 'active' : ''}}"
              wx:for="{{[1,2,3,4,5,6,7,8,9]}}"
              wx:key="*this"
              wx:for-item="item"
              data-key="{{trait.key}}"
              data-value="{{item}}"
              bindtap="onQuickScore"
            >{{item}}</view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>

  <!-- 底部导航 -->
  <view class="footer safe-bottom">
    <view class="nav-buttons">
      <button class="nav-btn prev" bindtap="onPrevCategory" disabled="{{currentCategoryIndex === 0}}">
        上一类
      </button>
      <button class="nav-btn next" bindtap="onNextCategory">
        {{currentCategoryIndex === categories.length - 1 ? '拍照' : '下一类'}}
      </button>
    </view>
    <view class="skip-link" bindtap="onSkipPhoto">
      <text>跳过拍照直接提交</text>
    </view>
  </view>

  <!-- 新手引导 -->
  <view class="guide-mask" wx:if="{{showGuide}}" bindtap="onCloseGuide">
    <view class="guide-content" catchtap="">
      <text class="guide-title">评分说明</text>
      <text class="guide-text">1. 使用滑块或点击数字快速评分</text>
      <text class="guide-text">2. 分数1-9，中间值为5</text>
      <text class="guide-text">3. 左右滑动切换性状分类</text>
      <text class="guide-text">4. 评完后可拍照记录</text>
      <button class="guide-btn" bindtap="onCloseGuide">知道了</button>
    </view>
  </view>
</view>
