/* pages/scoring/normal/normal.wxss */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 顶部信息 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.cattle-info {
  display: flex;
  align-items: center;
}

.ear-tag {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.mode-tag {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  background: #e8f5e9;
  color: #07C160;
  font-size: 24rpx;
  border-radius: 20rpx;
}

.score-preview {
  display: flex;
  align-items: baseline;
}

.score-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.score-grade {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 8rpx;
}

/* 分类选项卡 */
.category-tabs {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #07C160;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #07C160;
  border-radius: 3rpx;
}

.tab-weight {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 评分区域 */
.scoring-swiper {
  flex: 1;
  height: 0;
}

.trait-list {
  height: 100%;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.trait-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.trait-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.trait-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.trait-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #07C160;
}

.trait-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.label-low, .label-high {
  font-size: 24rpx;
  color: #999;
}

.score-slider {
  margin: 20rpx 0;
}

/* 快捷分数按钮 */
.quick-scores {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.quick-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.quick-btn.active {
  background: #07C160;
  color: #fff;
}

/* 底部导航 */
.footer {
  background: #fff;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
}

.nav-buttons {
  display: flex;
  gap: 20rpx;
}

.nav-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.nav-btn.prev {
  background: #f5f5f5;
  color: #666;
}

.nav-btn.prev[disabled] {
  opacity: 0.5;
}

.nav-btn.next {
  background: linear-gradient(135deg, #07C160 0%, #05a050 100%);
  color: #fff;
}

.skip-link {
  text-align: center;
  padding: 20rpx;
}

.skip-link text {
  font-size: 26rpx;
  color: #999;
}

/* 新手引导 */
.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.guide-content {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.guide-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
  text-align: center;
}

.guide-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 2;
}

.guide-btn {
  margin-top: 30rpx;
  background: #07C160;
  color: #fff;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
}
