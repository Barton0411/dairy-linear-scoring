/* pages/scoring/photo/photo.wxss */

.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.photo-item {
  width: calc(33.33% - 14rpx);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #fff;
  font-size: 24rpx;
}

/* 添加按钮 */
.add-photo {
  width: calc(33.33% - 14rpx);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.add-btn {
  flex: 1;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 2rpx dashed #ddd;
}

.add-btn.camera {
  background: #e8f5e9;
  border-color: #07C160;
}

.add-btn.album {
  background: #e3f2fd;
  border-color: #2196F3;
}

.add-icon {
  font-size: 36rpx;
  font-weight: bold;
}

.add-btn.camera .add-icon {
  color: #07C160;
}

.add-btn.album .add-icon {
  color: #2196F3;
}

.add-text {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.add-btn.camera .add-text {
  color: #07C160;
}

.add-btn.album .add-text {
  color: #2196F3;
}

/* 照片计数 */
.photo-count {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 28rpx;
}

/* 底部按钮 */
.footer {
  display: flex;
  gap: 20rpx;
  padding-top: 40rpx;
  margin-top: auto;
}

.btn-secondary, .btn-primary {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
}

.btn-secondary {
  background: #f5f5f5;
  color: #666;
}

.btn-primary {
  background: linear-gradient(135deg, #07C160 0%, #05a050 100%);
  color: #fff;
}
