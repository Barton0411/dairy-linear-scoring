/* pages/scoring/photo/photo.wxss */

.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 18rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1c1c1e;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #5f6464;
  margin-top: 10rpx;
  display: block;
}

/* 网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 10rpx;
}

.grid-item {
  position: relative;
  border-radius: 18rpx;
  overflow: hidden;
  background: #fff;
  border: 2rpx solid #e0edf6;
  aspect-ratio: 1;
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-delete {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
}

.add-cell {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #fff;
}

.add-plus {
  font-size: 56rpx;
  font-weight: 600;
  color: #9aa3a6;
  line-height: 1;
}

.add-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5f6464;
}

.empty-cell {
  width: 100%;
  height: 100%;
  background: #fff;
}

.photo-count {
  text-align: center;
  padding: 22rpx 0;
  color: #5f6464;
  font-size: 26rpx;
}

.footer {
  display: flex;
  gap: 20rpx;
  margin-top: auto;
  padding-top: 10rpx;
}

.btn-secondary,
.btn-primary {
  flex: 1;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  margin: 0;
}

.btn-secondary::after,
.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #eef0f2;
  color: #5f6464;
}

.btn-primary {
  background: #0087cd;
  color: #fff;
  box-shadow: none;
}
