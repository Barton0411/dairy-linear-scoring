/* pages/login/login.wxss */

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 180rpx 48rpx 60rpx;
  box-sizing: border-box;
  background: #f2f8fb;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1c1c1e;
  text-align: center;
  line-height: 1.3;
}

.hero-subtitle {
  font-size: 28rpx;
  color: #5f6464;
}

.actions {
  padding: 0;
}

.btn-login {
  width: 100%;
  height: 96rpx;
  background: #0087cd;
  border-radius: 24rpx;
  border: none;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-login::after {
  border: none;
}

.btn-login:active {
  opacity: 0.9;
}

.btn-login[disabled] {
  background: #d8e7f2;
  opacity: 1;
}

.agreement-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid #e0edf6;
  padding: 26rpx 22rpx;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
}

.agreement-text {
  font-size: 24rpx;
  color: #5f6464;
  line-height: 1.6;
  margin-left: 10rpx;
  flex: 1;
}

.agreement-text text {
  display: inline;
}

.link {
  color: #0087cd;
  display: inline;
}

.footer {
  text-align: center;
  padding-top: 40rpx;
}

.brand-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.brand-logo {
  width: 140rpx;
  height: 108rpx;
  display: block;
}

.brand-team {
  font-size: 22rpx;
  color: #5f6464;
}

.footer-text {
  font-size: 24rpx;
  color: #9aa3a6;
}
