/* pages/login/login.wxss */

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 100rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f8fff8 0%, #ffffff 100%);
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #999;
}

/* 登录区域 */
.login-section {
  padding: 60rpx 0;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07C160 0%, #05a050 100%);
  border-radius: 48rpx;
  border: none;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

.login-btn::after {
  border: none;
}

.btn-icon {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-weight: bold;
}

.btn-text {
  font-size: 32rpx;
}

/* 协议 */
.agreement {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
}

.agreement-label {
  display: flex;
  align-items: flex-start;
}

.agreement-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-left: 8rpx;
}

.link {
  color: #07C160;
}

/* 底部 */
.footer {
  text-align: center;
  padding-bottom: env(safe-area-inset-bottom);
}

.footer-text {
  font-size: 24rpx;
  color: #ccc;
}
