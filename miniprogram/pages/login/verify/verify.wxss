/* pages/login/verify/verify.wxss */

.container {
  min-height: 100vh;
  padding: 60rpx 40rpx 0;
  box-sizing: border-box;
  background: #f2f8fb;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.content-wrapper {
  flex: 1;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1c1c1e;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #5f6464;
  margin-top: 16rpx;
  display: block;
}

.form-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
}

.form-group {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e0edf6;
}

.form-group:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #5f6464;
  display: block;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  color: #1c1c1e;
}

.tips {
  margin-top: 30rpx;
  padding: 0 10rpx;
}

.tips-text {
  display: block;
  font-size: 24rpx;
  color: #5f6464;
  line-height: 1.8;
}

.action-section {
  padding: 30rpx 0 40rpx;
  background: #f2f8fb;
}

.btn-primary {
  height: 96rpx;
  background: #0087cd;
  color: #fff;
  border-radius: 24rpx;
  font-size: 34rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.88;
}

.btn-primary[disabled] {
  opacity: 0.5;
}
