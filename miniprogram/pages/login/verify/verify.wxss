/* pages/login/verify/verify.wxss */

.container {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
  display: block;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
}

.form-group {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}

.form-group:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  color: #333;
}

.tips {
  margin-top: 30rpx;
  padding: 0 10rpx;
}

.tips-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #07C160 0%, #05a050 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 34rpx;
}

.btn-primary[disabled] {
  opacity: 0.5;
}
