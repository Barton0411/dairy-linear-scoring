<!--pages/login/verify/verify.wxml-->
<nav-header title="身份认证" />
<view class="container">
  <view class="content-wrapper">
    <view class="header">
      <text class="title">请输入姓名与工号</text>
      <text class="subtitle">用于验证鉴定员身份</text>
    </view>

    <view class="form-section">
      <view class="form-group">
        <text class="form-label">姓名</text>
        <input
          class="form-input"
          placeholder="请输入真实姓名"
          value="{{name}}"
          bindinput="onNameInput"
        />
      </view>

      <view class="form-group">
        <text class="form-label">工号</text>
        <input
          class="form-input"
          type="digit"
          placeholder="请输入鉴定员工号"
          value="{{employeeId}}"
          bindinput="onEmployeeIdInput"
        />
      </view>
    </view>

  </view>

  <view class="action-section safe-bottom">
    <button
      class="btn-primary btn-block"
      bindtap="onVerify"
      loading="{{loading}}"
      disabled="{{loading || !name || !employeeId}}"
    >
      验证并进入
    </button>
  </view>
</view>
