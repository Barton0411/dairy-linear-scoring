<!--pages/index/index.wxml-->
<view class="container">
  <!-- 用户信息 -->
  <view class="user-card card">
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatarUrl || '/assets/icons/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="user-detail">
        <text class="nickname">{{userInfo.name || '鉴定员'}}</text>
        <text class="role">鉴定员</text>
      </view>
    </view>
  </view>

  <!-- 当前牧场 -->
  <view class="farm-card card" bindtap="onSelectFarm">
    <view class="farm-header">
      <text class="farm-label">当前牧场</text>
      <text class="farm-action">切换 ></text>
    </view>
    <view class="farm-name" wx:if="{{currentFarm}}">
      <text class="name">{{currentFarm.name}}</text>
      <text class="code">编号: {{currentFarm.code}}</text>
    </view>
    <view class="farm-empty" wx:else>
      <text>点击选择牧场</text>
    </view>
  </view>

  <!-- 同步状态 -->
  <view class="sync-card card" wx:if="{{pendingSyncCount > 0}}" bindtap="onManualSync">
    <view class="sync-info">
      <text class="sync-icon">!</text>
      <text class="sync-text">待同步: {{pendingSyncCount}} 条数据</text>
    </view>
    <text class="sync-action">{{loading ? '同步中...' : '点击同步'}}</text>
  </view>

  <!-- 快速开始 -->
  <view class="action-section">
    <view class="section-title">开始评分</view>

    <view class="action-card card" bindtap="onStartNormal">
      <view class="action-icon normal-icon">N</view>
      <view class="action-content">
        <text class="action-title">正常模式</text>
        <text class="action-desc">逐一评定所有20个性状</text>
      </view>
      <text class="action-arrow">></text>
    </view>

    <view class="action-card card" bindtap="onStartDefect">
      <view class="action-icon defect-icon">D</view>
      <view class="action-content">
        <text class="action-title">缺陷模式</text>
        <text class="action-desc">只评异常性状，其他默认分</text>
      </view>
      <text class="action-arrow">></text>
    </view>
  </view>
</view>
