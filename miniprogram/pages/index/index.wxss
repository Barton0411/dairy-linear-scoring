/* pages/index/index.wxss */

.container {
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

/* 用户卡片 */
.user-card {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.settings-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f2f3;
  border-radius: 18rpx;
  margin-left: 20rpx;
}

.settings-btn:active {
  opacity: 0.7;
  background: #e8e8e8;
}

.settings-icon {
  font-size: 40rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #0087cd;
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-text {
  line-height: 1;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.role {
  font-size: 26rpx;
  color: #5f6464;
  margin-top: 8rpx;
}

.guest-hint {
  color: #ff9800;
  font-weight: 500;
}

/* 证书通知横幅 */
.cert-notification {
  margin: 20rpx 0;
  padding: 24rpx;
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #ff9800;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.15);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.15);
  }
  50% {
    box-shadow: 0 6rpx 16rpx rgba(255, 152, 0, 0.25);
  }
}

.cert-notification:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.notification-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  animation: ring 1.5s infinite;
}

@keyframes ring {
  0%, 100% { transform: rotate(0deg); }
  10%, 30% { transform: rotate(-10deg); }
  20%, 40% { transform: rotate(10deg); }
}

.notification-content {
  flex: 1;
}

.notification-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e65100;
  display: block;
  margin-bottom: 4rpx;
}

.notification-subtitle {
  font-size: 24rpx;
  color: #f57c00;
  opacity: 0.8;
}

.notification-arrow {
  font-size: 40rpx;
  color: #ff9800;
  font-weight: 600;
}

/* 牧场卡片 */
.farm-card {
  padding: 30rpx;
}

.farm-card:active {
  opacity: 0.92;
  transform: scale(0.99);
}

.farm-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.farm-label {
  font-size: 28rpx;
  color: #5f6464;
}

.farm-action {
  font-size: 26rpx;
  color: #0087cd;
}

.farm-name {
  display: flex;
  flex-direction: column;
}

.farm-name .name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.farm-name .code {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.farm-empty {
  color: #999;
  font-size: 30rpx;
}

/* 同步卡片 */
.sync-card {
  padding: 0;
  background: #fff3cd;
  overflow: hidden;
}

.sync-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
}

.sync-info {
  display: flex;
  align-items: center;
}

.sync-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.sync-text {
  font-size: 28rpx;
  color: #856404;
  font-weight: 600;
}

.sync-toggle {
  font-size: 24rpx;
  color: #856404;
}

/* 离线评分列表 */
.offline-list {
  padding: 0 30rpx 20rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.offline-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid #ffc107;
}

.offline-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.offline-ear-tag {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.offline-score-badge {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.offline-score-badge .score-number {
  font-size: 32rpx;
  font-weight: bold;
}

.offline-score-badge .score-grade {
  font-size: 24rpx;
  font-weight: 600;
}

.offline-item-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.offline-farm, .offline-time {
  font-size: 24rpx;
  color: #666;
}

.offline-item-meta {
  display: flex;
  gap: 16rpx;
}

.offline-mode, .offline-parity {
  font-size: 22rpx;
  color: #999;
  background: #f1f2f3;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 同步按钮 */
.sync-action-btn {
  background: #ffc107;
  color: #fff;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

.sync-action-btn:active {
  opacity: 0.8;
}

/* 操作区域 */
.action-section {
  margin-top: 40rpx;
}

.brand-section {
  margin-top: 40rpx;
}

.brand-card {
  padding: 24rpx;
}

.brand-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-logo {
  width: 160rpx;
  height: 124rpx;
  display: block;
  flex-shrink: 0;
}

.brand-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.brand-app {
  font-size: 24rpx;
  color: #1c1c1e;
  line-height: 1.5;
}

.brand-dev {
  font-size: 24rpx;
  color: #5f6464;
  line-height: 1.5;
}

.brand-contact {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  text-align: center;
}

.brand-contact:active {
  opacity: 0.8;
  background: #e9ecef;
}

.contact-btn {
  font-size: 28rpx;
  color: #0087cd;
  font-weight: 500;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 24rpx;
}

.action-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.action-card:active {
  opacity: 0.92;
  transform: scale(0.99);
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 24rpx;
}

.normal-icon {
  background: #0087cd;
}

.defect-icon {
  background: linear-gradient(135deg, #ff9500 0%, #ff7b00 100%);
}

.records-icon {
  background: #0087cd;
  font-size: 44rpx;
}

.action-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.action-desc {
  font-size: 26rpx;
  color: #5f6464;
  margin-top: 8rpx;
}

.action-arrow {
  font-size: 32rpx;
  color: #ccc;
}
