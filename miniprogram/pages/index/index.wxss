/* pages/index/index.wxss */

.container {
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

/* 用户卡片 */
.user-card {
  padding: 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #f0f0f0;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.role {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 牧场卡片 */
.farm-card {
  padding: 30rpx;
}

.farm-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.farm-label {
  font-size: 28rpx;
  color: #666;
}

.farm-action {
  font-size: 26rpx;
  color: #07C160;
}

.farm-name {
  display: flex;
  flex-direction: column;
}

.farm-name .name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.farm-name .code {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.farm-empty {
  color: #999;
  font-size: 30rpx;
}

/* 同步卡片 */
.sync-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff3cd;
}

.sync-info {
  display: flex;
  align-items: center;
}

.sync-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffc107;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 16rpx;
}

.sync-text {
  font-size: 28rpx;
  color: #856404;
}

.sync-action {
  font-size: 26rpx;
  color: #856404;
}

/* 操作区域 */
.action-section {
  margin-top: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.action-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 24rpx;
}

.normal-icon {
  background: linear-gradient(135deg, #07C160 0%, #05a050 100%);
}

.defect-icon {
  background: linear-gradient(135deg, #ff9500 0%, #ff7b00 100%);
}

.action-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.action-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.action-arrow {
  font-size: 32rpx;
  color: #ccc;
}
