.container {
  padding: 20rpx;
  background: transparent;
  min-height: 100vh;
}

.header {
  background: #fff;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.trait-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
}

.trait-item {
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #eee;
}

.trait-item:last-child {
  border-bottom: none;
}

.trait-name {
  font-size: 32rpx;
  color: #0087cd;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}
