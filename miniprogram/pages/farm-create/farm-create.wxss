/* pages/farm-create/farm-create.wxss */

.container {
  min-height: 100vh;
  padding: 30rpx;
  background: transparent;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1c1e;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #5f6464;
  display: block;
}

.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  flex: 1;
  border: 2rpx solid #e0edf6;
  box-shadow: none;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  color: #5f6464;
  margin-bottom: 16rpx;
  display: block;
}

.form-label.required::before {
  content: '*';
  color: #ef4444;
  margin-right: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d8d8d8;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f6fbfd;
}

.form-input:focus {
  border-color: #0087cd;
  background: #fff;
}

.form-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5f6464;
  line-height: 1.6;
}

.action-area {
  padding: 30rpx 0;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #0087cd;
  color: #fff;
  border: none;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
}
