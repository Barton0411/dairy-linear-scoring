.diagram-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.diagram-content {
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
}

.diagram-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  background: #fff;
}

.diagram-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  color: #999;
  font-weight: normal;
  cursor: pointer;
}

.close-btn:active {
  opacity: 0.6;
}

.diagram-scroll {
  flex: 1;
  width: 100%;
  overflow-y: auto;
  background: #fff;
}

.diagram-image {
  width: 100%;
  display: block;
  background: #fff;
}

.error-message {
  padding: 40rpx;
  text-align: center;
  color: #ef4444;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.error-path {
  font-size: 24rpx;
  color: #999;
  word-break: break-all;
}
